<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 
        PALETTE LAYER - Literal, theme-agnostic color values
        Convention: These keys should only be referenced by Role files, not components.
    -->

    <!-- Purple/Pink range (YCTP buttons) -->
    <Color x:Key="Palette.Purple.900">#8c0d93</Color>
    <Color x:Key="Palette.Purple.950">#3f043e</Color>

    <!-- Green range -->
    <Color x:Key="Palette.Green.300">#bef0c0</Color>
    <Color x:Key="Palette.Green.400">#75e170</Color>
    <Color x:Key="Palette.Green.500">#5EC458</Color>
    <Color x:Key="Palette.Green.600">#40BE2C</Color>
    <Color x:Key="Palette.Green.600c">#46bb77</Color>
    <Color x:Key="Palette.Green.700">#026012</Color>
    <Color x:Key="Palette.Green.700b">#118500</Color>
    <Color x:Key="Palette.Green.800">#004D10</Color>
    <Color x:Key="Palette.Green.800b">#10591D</Color>
    <Color x:Key="Palette.Green.900">#063112</Color>

    <!-- Gray/Neutral range -->
    <Color x:Key="Palette.Gray.600">#949794</Color>
    <Color x:Key="Palette.Neutral.800">#2D2D2D</Color>

    <!-- Teal range -->
    <Color x:Key="Palette.Teal.800">#285847</Color>
    <Color x:Key="Palette.Teal.900">#164d42</Color>

    <!-- Yellow range -->
    <Color x:Key="Palette.Yellow.300">#FFF900</Color>
    <Color x:Key="Palette.Yellow.700">#85820A</Color>

    <!-- Red range -->
    <Color x:Key="Palette.Red.500">#FF1F2B</Color>
    <Color x:Key="Palette.Red.800">#85090A</Color>

    <!-- White -->
    <Color x:Key="Palette.White">#FFFFFF</Color>

    <!-- Lime -->
    <Color x:Key="Palette.Lime.400">#12FF00</Color>

    <!-- Menu radial gradient colors (Dark) -->
    <Color x:Key="Palette.Teal.700">#1A3B2A</Color>
    <Color x:Key="Palette.Teal.950">#0A1A12</Color>
    <Color x:Key="Palette.Teal.800b">#1E4D33</Color>
    <Color x:Key="Palette.Teal.850">#1A402A</Color>
    <Color x:Key="Palette.Teal.900b">#173D28</Color>
    <Color x:Key="Palette.Teal.900c">#143B25</Color>
    <Color x:Key="Palette.Teal.950b">#0F2E1D</Color>
    <Color x:Key="Palette.Teal.950c">#0D2A1B</Color>
    <Color x:Key="Palette.Teal.950d">#0C271A</Color>
    <Color x:Key="Palette.Teal.950e">#0B2418</Color>
    <Color x:Key="Palette.Teal.950f">#06120D</Color>

    <!-- Menu radial gradient colors (Light) -->
    <Color x:Key="Palette.Green.300b">#68e29b</Color>
    <Color x:Key="Palette.Teal.700b">#286554</Color>
    <Color x:Key="Palette.Teal.750">#3ba065</Color>
    <Color x:Key="Palette.Teal.800c">#36945d</Color>
    <Color x:Key="Palette.Teal.850b">#287347</Color>
    <Color x:Key="Palette.Teal.900d">#286447</Color>
    <Color x:Key="Palette.Teal.900e">#285f47</Color>
</ResourceDictionary>
