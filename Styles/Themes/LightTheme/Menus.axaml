<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Main Menus Background -->
    <RadialGradientBrush x:Key="MainMenus-Bg"
                         Center="150%, -25%"
                         GradientOrigin="150%, -25%"
                         RadiusX="375%"
                         RadiusY="285%">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="{StaticResource Color.Menu.Bg.Start}" Offset="0"/>
            <GradientStop Color="{StaticResource Color.Menu.Bg.End}" Offset="0.85"/>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- Top Menu Background -->
    <RadialGradientBrush x:Key="TopMenu-Bg"
                         Center="11%, 5%"
                         GradientOrigin="11%, 5%"
                         RadiusX="100%"
                         RadiusY="135%">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="{StaticResource Color.Menu.Top.0}" Offset="0"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.12}" Offset="0.12"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.185}" Offset="0.185"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.25}" Offset="0.25"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.50}" Offset="0.5"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.59}" Offset="0.59"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.65}" Offset="0.65"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.75}" Offset="0.75"/>
            <GradientStop Color="{StaticResource Color.Menu.Top.85}" Offset="0.85"/>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- Other Menu Resources -->
    <SolidColorBrush x:Key="Menu-Header-Bg" Color="{StaticResource Color.Menu.Header.Bg}"/>
    <SolidColorBrush x:Key="Generic-Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Generic-Border-Shadow" Color="{StaticResource Color.Border.Subtle}"/>
</ResourceDictionary>